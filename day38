public class CountSpacesInString{
    public static void main(String[] args) {
        String str = "Anushree 1 5";
        int count = 0;

        for (int i = 0; i < str.length(); i++) {
            if (Character.isSpaceChar(str.charAt(i))) {
                count++;
            }
        }
        System.out.println(count);
    }
}
